<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast-DDS: UDPv4-only transport (shared-memory transport disabled). A dev-box workaround: this machine
     accumulates thousands of stale /dev/shm/fastrtps_* segments from other ROS/Isaac/container processes, which
     slows or breaks Fast-DDS SHM discovery (ros2 service list and node clients time out). Point
     FASTRTPS_DEFAULT_PROFILES_FILE at this file so the servo demo discovers over loopback UDP instead. Not needed
     on a clean machine or on the real-arm bench. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_only_tp</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="udp_only_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>udp_only_tp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
