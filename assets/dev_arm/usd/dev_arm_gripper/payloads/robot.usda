        </dev_arm/Geometry/link_0/link_1/link_2/link_3/link_4/link_5/link_6/gripper_palm/finger_right>,
        </dev_arm/Geometry/link_0/link_1/link_2/link_3/link_4/link_5/link_6/tcp>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "link_0" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
