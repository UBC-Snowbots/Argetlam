        </dev_arm/Physics/finger_right_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </dev_arm/Geometry/link_0/link_1/link_2/link_3/link_4/link_5/link_6>,
        </dev_arm/Geometry/link_0/link_1/link_2/link_3/link_4/link_5>,
        </dev_arm/Geometry/link_0/link_1/link_2/link_3/link_4>,
